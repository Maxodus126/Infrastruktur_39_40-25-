{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowS3ReadOnly",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:ListBucket"
            ],
            "Resource": [
                "arn:aws:s3:::mahasiswa-20230001-bucket",
                "arn:aws:s3:::mahasiswa-20230001-bucket/*"
            ]
        }
    ]
}
